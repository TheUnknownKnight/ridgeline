{
  "name": "ridgeline",
  "version": "2.0.0",
  "private": true,
  "description": "Backcountry route hazard checker: cross-references a GPX route against live wildfire, NWS alert, avalanche, river and forecast data.",
  "type": "module",
  "engines": {
    "node": ">=20.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"node --watch-path=server --watch-path=shared server/index.js\" \"vite\"",
    "dev:lan": "concurrently -n api,web -c green,cyan \"node --watch-path=server --watch-path=shared server/index.js\" \"vite --host\"",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test \"tests/*.test.js\"",
    "bench": "node scripts/bench.js"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "maplibre-gl": "6.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "vite": "^8.1.3"
  }
}
